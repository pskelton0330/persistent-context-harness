{
  "_comment": "Reference only — prefer `bash install/install-claude.sh` (or `python install/merge-claude-settings.py`), which fills these in for your OS and merges safely. If copying by hand: replace PCH_DIR with your checkout path (forward slashes even on Windows, e.g. C:/Users/you/persistent-context-harness) and PCH_PY with the interpreter token (python3 on macOS/Linux, python on Windows).",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          { "type": "command", "command": "PCH_PY PCH_DIR/hooks/session_start.py" }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "PCH_PY PCH_DIR/hooks/prompt_submit.py" },
          { "type": "command", "command": "PCH_PY PCH_DIR/bin/credential-guard" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "bash PCH_DIR/hooks/post-tool-use-hook.sh" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "PCH_PY PCH_DIR/hooks/lesson_capture.py" }
        ]
      }
    ]
  }
}
