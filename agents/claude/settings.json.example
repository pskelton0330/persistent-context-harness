{
  "_comment": "Copy the relevant hooks into your ~/.claude/settings.json (or a project .claude/settings.json). Replace PCH_DIR with the absolute path to your persistent-context-harness checkout, e.g. /home/you/persistent-context-harness.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          { "type": "command", "command": "python3 PCH_DIR/hooks/session_start.py" }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "python3 PCH_DIR/hooks/prompt_submit.py" },
          { "type": "command", "command": "python3 PCH_DIR/bin/credential-guard" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "bash PCH_DIR/hooks/post-tool-use-hook.sh" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "python3 PCH_DIR/hooks/lesson_capture.py" }
        ]
      }
    ]
  }
}
