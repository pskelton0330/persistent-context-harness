{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          { "type": "command", "command": "PCH_PY PCH_DIR/agents/codex/hooks/codex_hook.py session-start", "timeout": 15 }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "PCH_PY PCH_DIR/agents/codex/hooks/codex_hook.py user-prompt-submit", "timeout": 20 },
          { "type": "command", "command": "PCH_PY PCH_DIR/bin/credential-guard", "timeout": 5 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^apply_patch$",
        "hooks": [
          { "type": "command", "command": "PCH_PY PCH_DIR/agents/codex/hooks/codex_hook.py post-tool-use", "timeout": 5 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "PCH_PY PCH_DIR/agents/codex/hooks/codex_hook.py stop", "timeout": 10 }
        ]
      }
    ]
  }
}
