#!/usr/bin/env bash
# kb-selftest — verify the harness works, and report which agents are wired.
#
# Core checks must pass. Agent checks are informational: an agent you don't use
# is reported as "absent (skipped)", never a failure — any subset of
# Claude / Codex / Hermes is a valid setup. Exit 0 iff core checks pass.
set -euo pipefail
. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/_common.sh"

pass=0 fail=0
ok()   { printf '  \033[32mPASS\033[0m  %s\n' "$1"; pass=$((pass+1)); }
bad()  { printf '  \033[31mFAIL\033[0m  %s\n' "$1"; fail=$((fail+1)); }
info() { printf '  %s\n' "$1"; }

warn() { printf '  \033[33mWARN\033[0m  %s\n' "$*"; }

# Is a keychain backend actually usable on this machine? Distinguishes "not
# installed" from "installed but broken" — only the second is a real failure.
degraded=0
degraded_why=""
_pch_secret_hint=""
_pch_secret_backend_present() {
  case "${KB_SECRET_BACKEND:-auto}" in
    macos) command -v security >/dev/null 2>&1 ;;
    libsecret) command -v secret-tool >/dev/null 2>&1 ;;
    windows) command -v powershell.exe >/dev/null 2>&1 || command -v powershell >/dev/null 2>&1 ;;
    *)
      case "$PCH_OS" in
        mac) command -v security >/dev/null 2>&1 ;;
        windows) command -v powershell.exe >/dev/null 2>&1 || command -v powershell >/dev/null 2>&1 ;;
        *) command -v secret-tool >/dev/null 2>&1 ;;
      esac
      ;;
  esac
}
case "${KB_SECRET_BACKEND:-auto}" in
  macos) _pch_secret_hint="expected the 'security' command" ;;
  libsecret) _pch_secret_hint="install libsecret-tools, e.g. apt-get install libsecret-tools" ;;
  windows) _pch_secret_hint="expected Windows PowerShell (powershell.exe) on PATH" ;;
  *) case "$PCH_OS" in
       mac) _pch_secret_hint="expected the 'security' command" ;;
       windows) _pch_secret_hint="expected Windows PowerShell (powershell.exe) on PATH" ;;
       *) _pch_secret_hint="install libsecret-tools, e.g. apt-get install libsecret-tools" ;;
     esac ;;
esac

echo "== core =="
KB="$PCH_BIN_DIR/kb"

# Privacy advisory. The wiki/ shipped with this repo is a FICTIONAL EXAMPLE;
# real notes belong in a private KB_ROOT OUTSIDE the repo. KB_ROOT defaults to
# the repo wiki/, so warn if it still points inside the checkout: captured
# lessons would then live in a clone of a public repo. (.gitignore already makes
# such content un-committable, but it should not sit there at all.)
_pch_kb_real="$(cd "$KB_ROOT" 2>/dev/null && pwd -P)/"
_pch_root_real="$(cd "$PCH_ROOT" 2>/dev/null && pwd -P)"
case "$_pch_kb_real" in
  "$_pch_root_real"/*)
    warn "KB_ROOT is inside this repo ($KB_ROOT) — the wiki/ here is only an EXAMPLE."
    warn "  Set KB_ROOT to a private directory OUTSIDE the repo (edit config/harness.env)"
    warn "  so your real notes never live in a clone of a public repo."
    ;;
esac
unset _pch_kb_real _pch_root_real

"$KB" context >/dev/null 2>&1 && ok "kb context runs" || bad "kb context"
"$KB" recall "startup timeout error" >/dev/null 2>&1 && ok "kb recall runs" || bad "kb recall"
"$KB" health >/dev/null 2>&1 && ok "kb health runs (example KB clean)" || bad "kb health"

tmp="$(mktemp -d)"
if KB_ROOT="$tmp" "$KB" lesson "selftest scaffold check" >/dev/null 2>&1 \
   && ls "$tmp"/lessons/*-selftest-scaffold-check.md >/dev/null 2>&1; then
  ok "kb lesson scaffolds a file"
else bad "kb lesson scaffold"; fi
rm -rf "$tmp"

# Secret round-trip against the OS keychain (fake value, cleaned up after).
sidx="$(mktemp)"; alias="pch.selftest.$$"; fake="selftest-fake-value-$$"
if printf '%s\n' "$fake" | KB_SECRET_INDEX="$sidx" "$PCH_BIN_DIR/secret" put "$alias" >/dev/null 2>&1 \
   && [ "$(KB_SECRET_INDEX="$sidx" "$PCH_BIN_DIR/secret" get "$alias" 2>/dev/null)" = "$fake" ]; then
  ok "secret put/get round-trips via the keychain"
elif ! _pch_secret_backend_present; then
  # No keychain backend installed. That is an environment gap, not a broken
  # system: priming, recall and capture do not depend on the secret CLI. Linux
  # images frequently ship without libsecret, and failing the whole selftest
  # over it would train people to ignore a red result.
  warn "no keychain backend — secret storage unavailable ($_pch_secret_hint)"
  degraded=1; degraded_why="$degraded_why secret-storage"
else bad "secret put/get"; fi
# cleanup keychain entry (best effort, all backends)
security delete-generic-password -a "$alias" -s "$KB_SECRET_SERVICE" >/dev/null 2>&1 || true
secret-tool clear service "$KB_SECRET_SERVICE" account "$alias" >/dev/null 2>&1 || true
rm -f "$KB_STATE_DIR"/secrets/*selftest* 2>/dev/null || true
rm -f "$sidx"

if printf '{"prompt":"the token=abcdef0123456789xyz is here"}' \
   | "$PCH_PYTHON" "$PCH_BIN_DIR/credential-guard" 2>/dev/null | grep -q '"block"'; then
  ok "credential-guard blocks a raw secret"
else bad "credential-guard"; fi

# ---------------------------------------------------------------------------
# Retrieval stack. The core checks above only prove the zero-dependency keyword
# path works. Reporting "the harness works" on that alone is how someone ends up
# with a green check and a system that never surfaces a lesson.
# ---------------------------------------------------------------------------
echo "== retrieval =="
if [ "$KB_RETRIEVER" = "semantic" ]; then
  py="${KB_PYTHON:-$PCH_PYTHON}"
  if ! command -v "$py" >/dev/null 2>&1; then
    warn "KB_PYTHON ($py) not executable — semantic disabled, keyword only"
    degraded=1; degraded_why="$degraded_why semantic"
  elif ! "$py" -c 'import requests, sqlite_vec' >/dev/null 2>&1; then
    warn "extras missing (requests/sqlite-vec) — run: bash install/install-extras.sh"
    degraded=1; degraded_why="$degraded_why semantic"
  else
    ok "semantic extras importable"
    # A brand-new knowledge base has no lessons yet. That is the expected
    # starting state, not a fault, and it is the first thing a new user sees.
    set +e
    # Counted inside `set +e`: with an empty lessons/ the glob matches nothing,
    # ls exits 1, and pipefail propagates that into the assignment — aborting
    # the whole selftest on precisely the fresh install this branch exists to
    # handle. Found by an agent running the documented setup end to end.
    n_lessons=$(ls -1 "$KB_ROOT"/lessons/*.md 2>/dev/null | wc -l | tr -d ' ')
    "$py" "$PCH_ROOT/lib/retrieval/lesson_retriever.py" --check >/tmp/pch-idx.$$ 2>&1
    rc=$?
    set -e
    if [ "${n_lessons:-0}" -eq 0 ]; then
      info "no lessons yet — capture your first with: kb lesson \"<title>\""
      rm -f /tmp/pch-idx.$$
      empty_kb=1
      rc=0
    fi
    if [ "${empty_kb:-0}" -eq 1 ]; then
      : # already reported above; nothing to grep, the temp file is gone
    elif [ "$rc" -eq 0 ]; then
      ok "semantic index healthy ($(grep '^lessons:' /tmp/pch-idx.$$ 2>/dev/null | head -1))"
    else
      warn "semantic index unusable: $(grep -E 'healthy:|index (missing|unreadable)' /tmp/pch-idx.$$ | head -1)"
      warn "  build it with: bin/kb index"
      degraded=1; degraded_why="$degraded_why semantic-index"
    fi
    rm -f /tmp/pch-idx.$$
  fi
else
  info "KB_RETRIEVER=keyword — semantic search intentionally disabled"
fi

# ---------------------------------------------------------------------------
# Hooks. These are what actually change agent behaviour in a session; without
# them the harness is a CLI, not a memory system.
# ---------------------------------------------------------------------------
echo "== hooks =="
for h in session_start prompt_submit lesson_capture; do
  if [ -f "$PCH_ROOT/hooks/$h.py" ] && "$PCH_PYTHON" -c "import ast,sys; ast.parse(open(sys.argv[1]).read())" "$PCH_ROOT/hooks/$h.py" >/dev/null 2>&1; then
    ok "hooks/$h.py present and parses"
  else
    bad "hooks/$h.py"
  fi
done

# ---------------------------------------------------------------------------
# Weekly self-improvement. Checked because a scheduled job that fails quietly is
# worse than no job at all — capture keeps adding lessons while nothing curates
# them, and quality decays invisibly.
# ---------------------------------------------------------------------------
echo "== weekly review =="
last="$KB_STATE_DIR/weekly/last-run.json"
if [ ! -f "$last" ]; then
  info "never run — schedule it with: bash weekly/install-schedule.sh"
else
  ran="$(sed -n 's/.*"ran_at": *"\([^"]*\)".*/\1/p' "$last" | head -1)"
  nfail="$(sed -n 's/.*"failed_steps": *\([0-9]*\).*/\1/p' "$last" | head -1)"
  if [ "${nfail:-0}" -gt 0 ]; then
    bad "last weekly run had ${nfail} failed step(s) at ${ran}"
    warn "  see $KB_STATE_DIR/weekly/ for the log"
  else
    ok "last weekly run clean ($ran)"
  fi
  # Stale means the schedule is not firing, which looks identical to "nothing
  # to do" unless it is checked.
  if [ -n "$ran" ] && command -v "$PCH_PYTHON" >/dev/null 2>&1; then
    age=$("$PCH_PYTHON" -c "
import datetime,sys
try:
    d=datetime.datetime.fromisoformat('$ran'.replace('Z','+00:00'))
    print(int((datetime.datetime.now(datetime.timezone.utc)-d).days))
except Exception: print(-1)")
    [ "$age" -gt 14 ] && warn "last weekly run was $age days ago — is the schedule active?"
  fi
fi

echo "== agents (absent = skipped, not a failure) =="
report_agent() { # name  cli  wired-test-cmd  wired-target
  local name="$1" cli="$2" cfg="$3"
  local have_cli=no wired=no
  command -v "$cli" >/dev/null 2>&1 && have_cli=yes
  [ -n "$cfg" ] && [ -f "$cfg" ] && grep -q "$PCH_ROOT" "$cfg" 2>/dev/null && wired=yes
  if [ "$have_cli" = no ] && [ "$wired" = no ]; then
    info "$name: absent (skipped)"
  elif [ "$wired" = yes ]; then
    printf '  \033[32mWIRED\033[0m %s (config references this repo)\n' "$name"
  else
    printf '  \033[33mREADY\033[0m %s CLI present but not wired yet — run install/install-%s.sh\n' "$name" "$(printf '%s' "$name" | tr 'A-Z' 'a-z')"
  fi
}
report_agent Claude claude "$HOME/.claude/settings.json"
report_agent Codex  codex  "$HOME/.codex/hooks.json"
# Hermes: skill-based, not config-path based.
if command -v hermes >/dev/null 2>&1; then
  [ -f "$HOME/.agents/skills/context-kb/SKILL.md" ] \
    && printf '  \033[32mWIRED\033[0m Hermes (context-kb skill installed)\n' \
    || printf '  \033[33mREADY\033[0m Hermes CLI present but skill not installed — run install/install-hermes.sh\n'
else
  info "Hermes: absent (skipped)"
fi

echo "== summary =="
echo "  core: $pass passed, $fail failed"
if [ "$fail" -ne 0 ]; then
  echo "  FAILED — see above."; exit 1
fi
if [ "${degraded:-0}" -ne 0 ]; then
  # Deliberately not "OK". The core works, but recall is running in its weaker
  # mode, and saying so plainly is the whole point of this check.
  echo "  DEGRADED — core works, but some capabilities are unavailable:${degraded_why}"
  case "$degraded_why" in
    *semantic*) echo "  Recall falls back to keyword matching, which is noticeably noisier." ;;
  esac
  echo "  Fix the warnings above, then re-run."
  exit 0
fi
echo "  OK — core works and semantic recall is live. Wire whichever agents you use."
exit 0
