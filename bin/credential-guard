#!/usr/bin/env python3
"""credential-guard — block raw secrets from entering an agent prompt.

Reads a hook payload (JSON with a "prompt" field) on stdin. If the prompt
contains what looks like a raw secret, it emits a message telling the user to
store it with the `secret` CLI instead, and signals the host to block the turn.

Intentional submission format (still keeps the raw value out of the model):
    alias: myapp.db.password
    secret: <value>
When both lines are present, store the value yourself via `secret put`, then
strip it before the prompt reaches the model.

This ships secret *detection patterns*, never any secret values.
"""
import json
import re
import sys

RAW_SECRET_PATTERNS = [
    r"(?is)-----BEGIN [A-Z0-9 ]*PRIVATE KEY-----",
    r"\bAKIA[0-9A-Z]{16}\b",                       # AWS access key id
    r"\bgh[pousr]_[A-Za-z0-9]{20,}\b",             # GitHub tokens
    r"\bxox[baprs]-[A-Za-z0-9-]{10,}\b",           # Slack tokens
    r"(?i)\b(password|passwd|secret|token|api[_-]?key)\s*[:=]\s*\S{8,}",
    r"://[^/\s:@]+:[^/\s:@]+@",                     # user:pass@host in a URL
]
INTENT_RE = re.compile(r"(?im)^\s*secret\s*:\s*\S+")


def has_raw_secret(text: str) -> bool:
    return any(re.search(p, text) for p in RAW_SECRET_PATTERNS)


def main() -> int:
    try:
        payload = json.load(sys.stdin)
    except Exception:
        return 0
    prompt = payload.get("prompt") or ""
    if not (has_raw_secret(prompt) or INTENT_RE.search(prompt)):
        return 0
    msg = (
        "This prompt appears to contain a raw secret. Store it in the OS keychain "
        "with `secret put <alias>` and reference the alias instead — never paste "
        "raw passwords, tokens, or private keys into prompts, files, or git."
    )
    print(json.dumps({"decision": "block", "reason": msg}))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
