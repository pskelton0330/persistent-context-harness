#!/usr/bin/env bash
# secret — store/use credentials by alias, backed by the OS keychain.
# Raw values live in macOS Keychain (security) or Linux libsecret (secret-tool),
# never in files, prompts, or git. Reference secrets by alias everywhere else.
#
#   secret put <alias>                 Store a value (prompted, not echoed).
#   secret get <alias>                 Print the value to stdout.
#   secret run <alias> <VAR> -- cmd…   Run cmd with $VAR set to the value.
#   secret list                        List known aliases (names only).
set -euo pipefail
. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/_common.sh"

SVC="$KB_SECRET_SERVICE"
INDEX="${KB_SECRET_INDEX:-$PCH_ROOT/config/secret-aliases.list}"

backend() {
  case "$KB_SECRET_BACKEND" in
    macos) echo macos ;;
    libsecret) echo libsecret ;;
    *) [ "$(uname -s)" = Darwin ] && echo macos || echo libsecret ;;
  esac
}

store() { # alias value
  case "$(backend)" in
    macos) security add-generic-password -a "$1" -s "$SVC" -w "$2" -U >/dev/null ;;
    libsecret) printf '%s' "$2" | secret-tool store --label="$SVC/$1" service "$SVC" account "$1" ;;
  esac
  grep -qxF "$1" "$INDEX" 2>/dev/null || { mkdir -p "$(dirname "$INDEX")"; echo "$1" >> "$INDEX"; }
}

fetch() { # alias -> value on stdout
  case "$(backend)" in
    macos) security find-generic-password -a "$1" -s "$SVC" -w 2>/dev/null ;;
    libsecret) secret-tool lookup service "$SVC" account "$1" ;;
  esac
}

case "${1:-}" in
  put)
    [ "${2:-}" ] || pch_die "usage: secret put <alias>"
    printf 'value for %s (input hidden): ' "$2" >&2
    read -rs val; echo >&2
    [ -n "$val" ] || pch_die "empty value"
    store "$2" "$val"; unset val
    echo "stored '$2' in $(backend) keychain (service: $SVC)" >&2
    ;;
  get)
    [ "${2:-}" ] || pch_die "usage: secret get <alias>"
    v="$(fetch "$2")" || true
    [ -n "${v:-}" ] || pch_die "no secret for alias '$2'"
    printf '%s\n' "$v"
    ;;
  run)
    # secret run <alias> <VAR> -- cmd args...
    al="${2:-}"; var="${3:-}"; sep="${4:-}"
    { [ -n "$al" ] && [ -n "$var" ] && [ "$sep" = "--" ]; } \
      || pch_die "usage: secret run <alias> <VAR> -- <command> [args...]"
    shift 4
    v="$(fetch "$al")" || true
    [ -n "${v:-}" ] || pch_die "no secret for alias '$al'"
    export "$var=$v"; unset v
    exec "$@"
    ;;
  list)
    if [ -f "$INDEX" ]; then sort -u "$INDEX"; else echo "(no aliases stored yet)"; fi
    ;;
  ""|-h|--help|help)
    sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'
    ;;
  *) pch_die "unknown subcommand: $1 (try: secret --help)" ;;
esac
