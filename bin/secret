#!/usr/bin/env bash
# secret — store/use credentials by alias, kept out of files, prompts and git.
# Raw values live in the OS-native store: macOS Keychain (security), Linux
# libsecret (secret-tool), or on Windows a per-user DPAPI-encrypted file (only
# the same Windows account can decrypt it). Reference secrets by alias elsewhere.
#
#   secret put <alias>                 Store a value (prompted, not echoed).
#   secret get <alias>                 Print the value to stdout.
#   secret run <alias> <VAR> -- cmd…   Run cmd with $VAR set to the value.
#   secret list                        List known aliases (names only).
#
# Aliases are restricted to [A-Za-z0-9._-]. That keeps them safe as filenames
# (the Windows backend maps an alias to a file) and as index entries, and avoids
# two distinct aliases colliding onto the same credential.
set -euo pipefail
. "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/_common.sh"

SVC="$KB_SECRET_SERVICE"
INDEX="${KB_SECRET_INDEX:-$PCH_ROOT/config/secret-aliases.list}"
# Per-user encrypted store for the Windows backend (see win_store/win_fetch).
SECRET_DIR="${KB_SECRET_DIR:-$KB_STATE_DIR/secrets}"

# Reject anything outside a safe, collision-free grammar: letters, digits,
# '.', '_', '-', non-empty, and NOT starting with '-'. Without this, `a/b` and
# `a?b` collapse onto the same Windows file, a newline corrupts the index, and a
# leading '-' is read as an option by grep AND by secret-tool's GLib parser
# (e.g. `-a` taken as `--all`). Applied to every backend for identical behaviour.
valid_name() {
  case "$1" in
    ''|-*|*[!A-Za-z0-9._-]*) return 1 ;;
    *) return 0 ;;
  esac
}
valid_alias() { valid_name "$1"; }

# The service name becomes a filename PREFIX in the Windows DPAPI store
# ("$SVC-$alias.dpapi"), so an unvalidated KB_SECRET_SERVICE could carry a '/'
# or other path character and place the blob outside SECRET_DIR. Hold it to the
# same safe grammar (the default "context-harness" passes).
valid_name "$SVC" || pch_die "invalid KB_SECRET_SERVICE '$SVC' (allowed: letters, digits, . _ -; no leading -)"

backend() {
  case "$KB_SECRET_BACKEND" in
    macos) echo macos ;;
    libsecret) echo libsecret ;;
    windows) echo windows ;;
    *) case "$PCH_OS" in
         mac) echo macos ;;
         windows) echo windows ;;
         *) echo libsecret ;;
       esac ;;
  esac
}

# Windows has no libsecret and no `security`. DPAPI (ProtectedData, CurrentUser
# scope) encrypts the value so only this Windows user account can read it back;
# the ciphertext is base64 in a per-alias file under SECRET_DIR. The value and
# the file path travel to PowerShell via the environment, never on the command
# line, so neither shows up in the process list.
# Alias is already validated by valid_alias(), so it is a safe filename as-is.
_win_file() { printf '%s/%s.dpapi' "$SECRET_DIR" "$SVC-$1"; }

win_store() { # alias value
  mkdir -p "$SECRET_DIR"
  # Lock the store to this user where the platform lets us (defense in depth for
  # integrity and against backup/sync exposure; DPAPI already handles secrecy).
  chmod 700 "$SECRET_DIR" 2>/dev/null || true
  local f tmp winf
  f="$(_win_file "$1")"
  # Encrypt+write to a sibling temp file, verify it succeeded and is non-empty,
  # THEN atomically rename over the destination. Truncating the real file first
  # (the old behaviour) would destroy a valid secret if PowerShell/DPAPI failed.
  tmp="$f.tmp.$$"; : > "$tmp"; winf="$(cygpath -w "$tmp")"
  if PCH_SEC_VAL="$2" PCH_SEC_FILE="$winf" powershell.exe -NoProfile -NonInteractive -Command '
    Add-Type -AssemblyName System.Security;
    $b=[Text.Encoding]::UTF8.GetBytes($env:PCH_SEC_VAL);
    $p=[Security.Cryptography.ProtectedData]::Protect($b,$null,[Security.Cryptography.DataProtectionScope]::CurrentUser);
    [IO.File]::WriteAllText($env:PCH_SEC_FILE,[Convert]::ToBase64String($p))' >/dev/null \
     && [ -s "$tmp" ]; then
    mv -f "$tmp" "$f"
  else
    rm -f "$tmp"
    return 1
  fi
}

win_fetch() { # alias -> value on stdout
  local f winf; f="$(_win_file "$1")"; [ -f "$f" ] || return 1; winf="$(cygpath -w "$f")"
  PCH_SEC_FILE="$winf" powershell.exe -NoProfile -NonInteractive -Command '
    Add-Type -AssemblyName System.Security;
    $t=[IO.File]::ReadAllText($env:PCH_SEC_FILE);
    $p=[Convert]::FromBase64String($t);
    $b=[Security.Cryptography.ProtectedData]::Unprotect($p,$null,[Security.Cryptography.DataProtectionScope]::CurrentUser);
    [Console]::Out.Write([Text.Encoding]::UTF8.GetString($b))' 2>/dev/null | tr -d '\r'
}

store() { # alias value
  case "$(backend)" in
    macos) security add-generic-password -a "$1" -s "$SVC" -w "$2" -U >/dev/null ;;
    libsecret) printf '%s' "$2" | secret-tool store --label="$SVC/$1" service "$SVC" account "$1" ;;
    windows) win_store "$1" "$2" || return 1 ;;
  esac
  # `--` and -F so an alias is a literal pattern; only record it AFTER the store
  # actually succeeded, so a failed write never leaves a dangling index entry.
  grep -qxF -- "$1" "$INDEX" 2>/dev/null || { mkdir -p "$(dirname "$INDEX")"; printf '%s\n' "$1" >> "$INDEX"; }
}

fetch() { # alias -> value on stdout
  case "$(backend)" in
    macos) security find-generic-password -a "$1" -s "$SVC" -w 2>/dev/null ;;
    libsecret) secret-tool lookup service "$SVC" account "$1" ;;
    windows) win_fetch "$1" ;;
  esac
}

case "${1:-}" in
  put)
    [ "${2:-}" ] || pch_die "usage: secret put <alias>"
    valid_alias "$2" || pch_die "invalid alias '$2' (allowed: letters, digits, . _ -)"
    printf 'value for %s (input hidden): ' "$2" >&2
    read -rs val; echo >&2
    [ -n "$val" ] || pch_die "empty value"
    store "$2" "$val" || { unset val; pch_die "failed to store '$2' (backend error; existing value, if any, is unchanged)"; }
    unset val
    printf "stored '%s' in the %s backend (service: %s)\n" "$2" "$(backend)" "$SVC" >&2
    ;;
  get)
    [ "${2:-}" ] || pch_die "usage: secret get <alias>"
    valid_alias "$2" || pch_die "invalid alias '$2' (allowed: letters, digits, . _ -)"
    v="$(fetch "$2")" || true
    [ -n "${v:-}" ] || pch_die "no secret for alias '$2'"
    printf '%s\n' "$v"
    ;;
  run)
    # secret run <alias> <VAR> -- cmd args...
    al="${2:-}"; var="${3:-}"; sep="${4:-}"
    { [ -n "$al" ] && [ -n "$var" ] && [ "$sep" = "--" ]; } \
      || pch_die "usage: secret run <alias> <VAR> -- <command> [args...]"
    valid_alias "$al" || pch_die "invalid alias '$al' (allowed: letters, digits, . _ -)"
    shift 4
    v="$(fetch "$al")" || true
    [ -n "${v:-}" ] || pch_die "no secret for alias '$al'"
    export "$var=$v"; unset v
    exec "$@"
    ;;
  list)
    if [ -f "$INDEX" ]; then sort -u "$INDEX"; else echo "(no aliases stored yet)"; fi
    ;;
  ""|-h|--help|help)
    sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'
    ;;
  *) pch_die "unknown subcommand: $1 (try: secret --help)" ;;
esac
