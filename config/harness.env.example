# Persistent Context Harness — configuration
#
# Copy to config/harness.env and edit. harness.env is gitignored so your
# machine-specific paths never get committed.
#
#   cp config/harness.env.example config/harness.env

# Where the knowledge base lives. Defaults to this repo's wiki/ if unset.
# For real/private notes, point this at a SEPARATE directory outside the repo:
#   export KB_ROOT="$HOME/notes/my-kb"
KB_ROOT="${KB_ROOT:-}"

# Colon-separated project roots the agents should prime context for. When an
# agent session opens inside one of these (or a subdir), the session-start hook
# loads hot context. Example:
#   KB_WORK_ROOTS="$HOME/code/service-a:$HOME/code/service-b"
KB_WORK_ROOTS="${KB_WORK_ROOTS:-$HOME}"

# Lesson retriever: "keyword" (grep, zero deps) or "semantic" (requires an
# embedding backend you wire yourself). Default keyword.
KB_RETRIEVER="${KB_RETRIEVER:-keyword}"

# Secret backend: "auto" picks macOS Keychain on Darwin, libsecret on Linux.
KB_SECRET_BACKEND="${KB_SECRET_BACKEND:-auto}"

# Service name used to namespace secrets in the OS keychain.
KB_SECRET_SERVICE="${KB_SECRET_SERVICE:-context-harness}"
