# ── Local config (may contain machine-specific paths) ──
config/harness.env
config/claude-settings.generated.json
config/secret-aliases.list

# ── Generated state. KB_STATE_DIR defaults to ./state, so an ordinary
#    `kb index` writes here. These artifacts are DERIVED FROM THE USER'S REAL
#    LESSONS: the vector index embeds their content, and the retrieval log
#    records their prompts. Committing any of it to a public repo would leak
#    private knowledge, so ignore the whole directory and the file types by
#    name in case KB_STATE_DIR is pointed somewhere else inside the repo. ──
state/
*.db
*.db.tmp
*.sqlite
*.sqlite-shm
*.sqlite-wal
retrieval-log.jsonl
run-logs/
gap-reports/
audit-reports/
crosslink-drafts/
hot-md-drafts/

# ── Private content. The harness ships only the example wiki/ skeleton.
#    Point KB_ROOT at a SEPARATE, private location for real notes — never
#    commit real lessons, systems, or credential aliases into this repo. ──
private/
local/
*.private.md

# ── ENFORCED privacy backstop for the example wiki/. The wiki/ here is a
#    FICTIONAL EXAMPLE only; real content belongs in a private KB_ROOT OUTSIDE
#    this repo. But KB_ROOT defaults to this wiki/, so a capture (or an agent
#    following the setup) can drop real lessons/system pages in here. These rules
#    make that content UN-COMMITTABLE: everything under the KB subdirectories is
#    ignored except the shipped example files and the .gitkeep placeholders. So
#    even a `git add -A` cannot leak private knowledge into this public repo. ──
wiki/lessons/*
wiki/systems/*
wiki/runbooks/*
wiki/reference/*
wiki/components/*
wiki/decisions/*
!wiki/runbooks/.gitkeep
!wiki/reference/.gitkeep
!wiki/components/.gitkeep
!wiki/decisions/.gitkeep
!wiki/lessons/2024-01-01-example-lesson.md
!wiki/systems/example-service.md

# ── Secrets must never be committed. Raw values live in the OS keychain. ──
.env
*.env
!*.env.example
*.key
*.pem
id_rsa*
id_ed25519*
*.p12
*.pfx
credentials.json
secrets.json
.secrets/

# ── OS / editor cruft ──
.DS_Store
*.swp
*~
.vscode/
.idea/
__pycache__/
*.pyc
